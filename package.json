{
	"name": "pantaw",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"db:migrate:local": "wrangler d1 migrations apply pantaw --local",
		"db:migrate:remote": "wrangler d1 migrations apply pantaw --remote",
		"db:export": "wrangler d1 export pantaw --output backup.sql",
		"mock:agent": "bun run scripts/mock-agent.ts",
		"release": "bun run scripts/release.ts",
		"i18n:extract": "lingui extract",
		"i18n:compile": "lingui compile"
	},
	"dependencies": {
		"@henrygd/queue": "^1.0.7",
		"@henrygd/semaphore": "^0.0.2",
		"@hono/valibot-validator": "^0.5.2",
		"@lingui/detect-locale": "^5.4.1",
		"@lingui/macro": "^5.4.1",
		"@lingui/react": "^5.4.1",
		"@nanostores/react": "^0.7",
		"@nanostores/router": "^0.11.0",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-direction": "^1.1.1",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.7",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-toast": "^1.2.15",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tanstack/react-query": "^5",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.13.12",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2",
		"cmdk": "^1.1.1",
		"d3-time": "^3.1.0",
		"hono": "^4.6.13",
		"lucide-react": "^0.452",
		"nanostores": "^0.11",
		"react": "^19",
		"react-dom": "^19",
		"recharts": "^2.15.4",
		"shiki": "^3.13.0",
		"tailwind-merge": "^3",
		"valibot": "^1.0.0-beta.9"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@cloudflare/vite-plugin": "^0.1.16",
		"@cloudflare/vitest-pool-workers": "^0.8.0",
		"@cloudflare/workers-types": "^4.20241224.0",
		"@lingui/cli": "^5.4.1",
		"@lingui/swc-plugin": "^5.6.1",
		"@lingui/vite-plugin": "^5.4.1",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/vite": "^4",
		"@types/react": "^19",
