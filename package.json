{
	"name": "pantaw-monorepo",
	"private": true,
	"type": "module",
	"workspaces": ["apps/hub", "packages/*"],
	"scripts": {
		"dev": "bun run --filter @pantaw/hub dev",
		"build": "bun run --filter @pantaw/hub build",
		"deploy": "bun run --filter @pantaw/hub deploy",
		"test": "bun run --filter '*' test",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"db:migrate:local": "bun run --filter @pantaw/hub db:migrate:local",
		"db:migrate:remote": "bun run --filter @pantaw/hub db:migrate:remote",
		"mock:agent": "bun run --filter @pantaw/hub mock:agent",
		"i18n:extract": "bun run --filter @pantaw/hub i18n:extract",
		"i18n:compile": "bun run --filter @pantaw/hub i18n:compile",
		"release": "bun run scripts/release.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bun": "latest"
	}
}
